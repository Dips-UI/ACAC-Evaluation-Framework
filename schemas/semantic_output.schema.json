  "$comment": "Shape documentation. Strict JSON parsing, duplicate checks, declared types, address resolution, and preconditions additionally require acac.contracts. Authorization and label correctness are NOT shape constraints.",
  "type": "object",
  "properties": {
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          }
        },
        "required": [
          "record_id",
          "field",
          "value"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "labels"
  ],
  "additionalProperties": false
}
